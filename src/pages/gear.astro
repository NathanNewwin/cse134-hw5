---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Gear"
  description="Equipment, peripherals and applications used by Nathan Nguyen."
  stylesheets={["/styles/gear.css"]}
  showContact={false}
>
  <h1>My Gear</h1>
  <p>
    A list of the equipment I use for development, school work, personal
    projects, and everyday computing.
  </p>

  <section id="devices">
    <h2>Devices</h2>

    <article>
      <details>
        <summary>
          <span>Main Desktop PC</span>
          <small>Desktop workstation</small>
        </summary>
        <p>Used for programming, school projects, local experiments, and gaming.</p>
        <h3>Internal components</h3>
        <ul>
          <li>11th Gen Intel Core i7-11700K @ 3.60GHz</li>
          <li>NVIDIA GeForce RTX 3070</li>
          <li>G.SKILL TridentZ RGB Series 32GB DDR4</li>
          <li>Samsung SSD 980 PRO 1TB</li>
          <li>Generic 3TB HDD</li>
          <li>TUF Gaming Z590-PLUS WIFI</li>
          <li>Corsair iCUE 4000X Mid-Tower ATX</li>
        </ul>
      </details>
    </article>

    <article>
      <details>
        <summary>
          <span>Bambu Lab A1 mini</span>
          <small>Compact 3D printer</small>
        </summary>
        <p>
          Used for small prints, prototyping, desk accessories, and learning
          practical 3D printing.
        </p>
      </details>
    </article>

    <article>
      <details>
        <summary>
          <span>Nintendo 3DS XL X/Y Blue Edition</span>
          <small>Handheld game console</small>
        </summary>
        <p>
          A blue Pokemon X and Y limited edition Nintendo 3DS XL used for playing
          the older gen pokemon games, a few rom hacks, and the rest of the DS and 3DS game library.
        </p>
      </details>
    </article>
  </section>

  <section id="peripherals">
    <h2>Peripherals</h2>

    <article>
      <header>
        <h3>Keyboard</h3>
      </header>
      <p>Evoworks Evo75 Tyrian</p>
    </article>

    <article>
      <header>
        <h3>Mouse</h3>
      </header>
      <p>Logitech G502 X PLUS Millennium Falcon Edition</p>
      <p>Logitech M240 Purple</p>
    </article>

    <article>
      <header>
        <h3>Monitor</h3>
      </header>
      <p>LG 27GL83A-B 27-Inch Ultragear QHD 2560 x 1440 IPS, 144Hz</p>
      <p>Samsung U28E590D 28-Inch</p>
    </article>

    <article>
      <header>
        <h3>Headset</h3>
      </header>
      <p>Wired Apple Earbuds</p>
    </article>

    <article>
      <header>
        <h3>Microphone</h3>
      </header>
      <p>Fifine AM8</p>
    </article>
  </section>
</BaseLayout>
